{
    "name": "1oakdigital/common_mailer_plugin",
    "description": "Laravel mail transport that sends emails through the common mailer API.",
    "type": "library",
    "license": "proprietary",
    "authors": [
        {
            "name": "Chris Cynarski",
            "email": "chris@cynarski.net"
        }
    ],
    "require": {
        "php": "^8.4",
        "guzzlehttp/guzzle": "^7.8 || ^8.0",
        "illuminate/events": "^13.0",
        "illuminate/http": "^13.0",
        "illuminate/mail": "^13.0",
        "illuminate/routing": "^13.0",
        "illuminate/support": "^13.0",
        "illuminate/validation": "^13.0",
        "symfony/mailer": "^8.0"
    },
    "require-dev": {
        "laravel/pint": "^1.19",
        "orchestra/testbench": "^11.0",
        "phpunit/phpunit": "^12.0"
    },
    "autoload": {
        "psr-4": {
            "OneOakDigital\\CommonMailer\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "OneOakDigital\\CommonMailer\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OneOakDigital\\CommonMailer\\CommonMailerServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
